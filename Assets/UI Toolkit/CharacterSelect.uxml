        <ui:Label text=" Ready?" name="Label" style="color: rgb(255, 255, 255); font-size: 70px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Galindo/Galindo-Regular.ttf?fileID=12800000&amp;guid=f4fcdda5c694e644792101a593f832ce&amp;type=3#Galindo-Regular&quot;); background-color: rgb(0, 0, 0);" />
    </ui:VisualElement>
