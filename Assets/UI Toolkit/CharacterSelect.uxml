    <ui:VisualElement name="Background" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/UI/Image/Selection%20Art/IMG_3595.png?fileID=2800000&amp;guid=1b114ee568d1c3b4f90c473953903ef2&amp;type=3#IMG_3595&quot;);" />
    <ui:VisualElement name="Title" class="title" style="flex-grow: 1; position: absolute; background-image: url(&quot;project://database/Assets/UI/Image/Selection%20Art/Character%20Selection%20Banner.png?fileID=2800000&amp;guid=7dfb9c76077d5f448b8999a9849c210e&amp;type=3#Character Selection Banner&quot;); top: 4%; left: 299px; width: 1316px; height: 164px; -unity-background-scale-mode: scale-and-crop;" />
    <ui:VisualElement name="CharacterLeft" class="character" style="flex-grow: 1; left: 22%;">
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; height: 500px; background-image: url(&quot;project://database/Assets/Art/DEV/Bassist/Lu-idle.png?fileID=2800000&amp;guid=cd42ad81f180dfb41a80495e881755e0&amp;type=3#Lu-idle&quot;); -unity-background-scale-mode: scale-and-crop;" />
        <ui:VisualElement class="character__label" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/UI/Image/Selection%20Art/Lu.png?fileID=2800000&amp;guid=75e12907b18934547b73e7567010d687&amp;type=3#Lu&quot;); -unity-background-scale-mode: scale-to-fit;" />
    </ui:VisualElement>
    <ui:VisualElement name="CharacterRight" class="character" style="flex-grow: 1; right: 24%;">
