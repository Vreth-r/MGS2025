    </ui:VisualElement>
    <ui:VisualElement name="P1Selector" class="selector leftCharacterSelected" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/UI/Image/Selection%20Art/Button%20Switch%20Character%20Selection%201.png?fileID=2800000&amp;guid=de42ed10f61fb8f42a04d03dbe3c8263&amp;type=3#Button Switch Character Selection 1&quot;);" />
    <ui:VisualElement name="P2Selector" class="selector rightCharacterSelected" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/UI/Image/Selection%20Art/p2Select.png?fileID=2800000&amp;guid=157e420a4b718304ea439b7db7ff5108&amp;type=3#p2Select&quot;);" />
    <ui:VisualElement style="flex-grow: 1; width: 150px; height: 150px; position: absolute; background-image: url(&quot;project://database/Assets/UI/Image/Selection%20Art/black%20button.png?fileID=2800000&amp;guid=98e2ff889e4faa1498ea80771aa60bbe&amp;type=3#black button&quot;); top: 57%; left: 46%;">
        <ui:VisualElement name="Spinny" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/UI/Image/Selection%20Art/Swap%20button%20(arrows%20only).png?fileID=2800000&amp;guid=37148a3fe6ffdee4ba65cf1f45fb3e26&amp;type=3#Swap button (arrows only)&quot;); width: 80%; height: 80%; translate: 15px 15px;" />
    </ui:VisualElement>
